---
import ReadMore from "../ui/ReadMore.astro";

interface Props {
  title: string;
  url: string;
  image: {
    url: string;
    alt?: string;
  };
  description: string;
  date?: string | Date;
  tags?: string[];
  featured?: boolean;
  class?: string;
}

const {
  title,
  url,
  image,
  description,
  date,
  tags = [],
  featured = false,
  class: className = "",
} = Astro.props;
---

<a
  href={url}
  class:list={[
    "group block h-full rounded-3xl focus:outline-none",
    className,
  ]}
>
  <article
    class="h-full flex flex-col justify-between p-5 max-md:p-4 rounded-3xl bg-white/90 dark:bg-zinc-900/60 overflow-hidden border border-neutral-200 dark:border-zinc-800 group-hover:border-mint-400 dark:group-hover:border-mint-400 transition-colors duration-200 ease-in-out shadow-md"
  >
    <div class="flex flex-col gap-4">
      <div class="relative overflow-hidden rounded-2xl w-full aspect-video bg-zinc-900/50">
        <img
          class="w-full h-full object-cover rounded-2xl"
          src={image.url}
          alt={image.alt || title}
          loading="lazy"
          decoding="async"
        />
        {
          featured && (
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-zinc-900/90 border border-transparent group-hover:border-mint-400/50 text-mint-300 transition-colors duration-200">
              Latest
            </span>
          )
        }
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
        {
          date && (
            <span class="flex flex-row text-xs font-semibold items-center gap-2 text-blacktext/80 dark:text-riptide-100">
              <svg
                width="14"
                height="14"
                viewBox="0 0 15 15"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="text-mint-500 dark:text-mint-400 shrink-0"
              >
                <path
                  d="M4.5 1C4.77614 1 5 1.22386 5 1.5V2H10V1.5C10 1.22386 10.2239 1 10.5 1C10.7761 1 11 1.22386 11 1.5V2H12.5C13.3284 2 14 2.67157 14 3.5V12.5C14 13.3284 13.3284 14 12.5 14H2.5C1.67157 14 1 13.3284 1 12.5V3.5C1 2.67157 1.67157 2 2.5 2H4V1.5C4 1.22386 4.22386 1 4.5 1ZM10 3V3.5C10 3.77614 10.2239 4 10.5 4C10.7761 4 11 3.77614 11 3.5V3H12.5C12.7761 3 13 3.22386 13 3.5V5H2V3.5C2 3.22386 2.22386 3 2.5 3H4V3.5C4 3.77614 4.22386 4 4.5 4C4.77614 4 5 3.77614 5 3.5V3H10ZM2 6V12.5C2 12.7761 2.22386 13 2.5 13H12.5C12.7761 13 13 12.7761 13 12.5V6H2ZM7 7.5C7 7.22386 7.22386 7 7.5 7C7.77614 7 8 7.22386 8 7.5C8 7.77614 7.77614 8 7.5 8C7.22386 8 7 7.77614 7 7.5ZM9.5 7C9.22386 7 9 7.22386 9 7.5C9 7.77614 9.22386 8 9.5 8C9.77614 8 10 7.77614 10 7.5C10 7.22386 9.77614 7 9.5 7ZM11 7.5C11 7.22386 11.2239 7 11.5 7C11.7761 7 12 7.22386 12 7.5C12 7.77614 11.7761 8 11.5 8C11.2239 8 11 7.77614 11 7.5ZM11.5 9C11.2239 9 11 9.22386 11 9.5C11 9.77614 11.2239 10 11.5 10C11.7761 10 12 9.77614 12 9.5C12 9.22386 11.7761 9 11.5 9ZM9 9.5C9 9.22386 9.22386 9 9.5 9C9.77614 9 10 9.22386 10 9.5C10 9.77614 9.77614 10 9.5 10C9.22386 10 9 9.77614 9 9.5ZM7.5 9C7.22386 9 7 9.22386 7 9.5C7 9.77614 7.22386 10 7.5 10C7.77614 10 8 9.77614 8 9.5C8 9.22386 7.77614 9 7.5 9ZM5 9.5C5 9.22386 5.22386 9 5.5 9C5.77614 9 6 9.22386 6 9.5C6 9.77614 5.77614 10 5.5 10C5.22386 10 5 9.7761 5 9.5ZM3.5 9C3.22386 9 3 9.22386 3 9.5C3 9.77614 3.22386 10 3.5 10C3.77614 10 4 9.77614 4 9.5C4 9.22386 3.77614 9 3.5 9ZM3 11.5C3 11.2239 3.22386 11 3.5 11C3.77614 11 4 11.2239 4 11.5C4 11.7761 3.77614 12 3.5 12C3.22386 12 3 11.7761 3 11.5ZM5.5 11C5.22386 11 5 11.2239 5 11.5C5 11.7761 5.22386 12 5.5 12C5.77614 12 6 11.7761 6 11.5C6 11.2239 5.77614 11 5.5 11ZM7 11.5C7 11.2239 7.22386 11 7.5 11C7.77614 11 8 11.2239 8 11.5C8 11.7761 7.77614 12 7.5 12C7.22386 12 7 11.7761 7 11.5ZM9.5 11C9.22386 11 9 11.2239 9 11.5C9 11.7761 9.22386 12 9.5 12C9.77614 12 10 11.7761 10 11.5C10 11.2239 9.77614 11 9.5 11Z"
                  fill="currentColor"
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                />
              </svg>
              {new Date(date).toLocaleDateString("en-US", {
                timeZone: "UTC",
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </span>
          )
        }

        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag: string) => (
                <span class="px-2.5 py-0.5 rounded-full border border-mint-400/50 bg-white/60 dark:bg-mint-900/20 text-mint-600 dark:text-mint-300 text-xs font-bold">
                  {tag}
                </span>
              ))}
            </div>
          )
        }
      </div>

      <div class="flex flex-col gap-2 px-1">
        <h3 class="text-2xl font-bold text-blacktext dark:text-mint-50 group-hover:text-mint-500 dark:group-hover:text-mint-400 transition-colors leading-tight">
          {title}
        </h3>
        <p class="text-base leading-6 font-medium text-blacktext/80 dark:text-gray-300 line-clamp-3">
          {description}
        </p>
      </div>
    </div>

    <div class="mt-5 pt-3 px-1 border-t border-zinc-200/50 dark:border-zinc-800/80 flex items-center justify-between">
      <ReadMore class="text-sm group-hover:text-mint-400 transition-colors" />
    </div>
  </article>
</a>
